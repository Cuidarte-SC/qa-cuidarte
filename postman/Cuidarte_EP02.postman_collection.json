              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje genérico (no revela si el usuario existe)\", () =>",
                  "  pm.expect(pm.response.json().error).to.eql(\"Credenciales inválidas\"));"
                ]
              }
            }
          ]
        },
