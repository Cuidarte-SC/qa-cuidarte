          ]
        }
      ]
    },
    {
      "name": "CP-FUN-01 · Autenticación (RF-1.1, NFR-SEG-2, NFR-SEG-9)",
      "description": "Login exitoso con JWT de corta vigencia, rechazo de credenciales inválidas y revocación al cerrar sesión.",
      "item": [
        {
          "name": "01 Login válido dr_carlos → 200 + JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"dr_carlos\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Entrega token JWT tipo Bearer\", () => {",
                  "  pm.expect(j.token).to.be.a(\"string\").and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
                  "  pm.expect(j.tipo).to.eql(\"Bearer\");",
                  "});",
                  "pm.test(\"Rol medico asignado\", () => pm.expect(j.usuario.rol).to.eql(\"medico\"));",
                  "pm.test(\"JWT con vigencia de 15 minutos (NFR-SEG-9)\", () => {",
                  "  const p = JSON.parse(atob(j.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "  pm.expect(p.exp - p.iat).to.eql(900);",
                  "});",
                  "pm.test(\"No expone el hash de la contraseña\", () => pm.expect(pm.response.text()).to.not.include(\"password_hash\"));",
                  "pm.collectionVariables.set(\"tokenMedico\", j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login contraseña incorrecta → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
